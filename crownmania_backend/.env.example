# ==============================================
# CROWNMANIA BACKEND ENVIRONMENT VARIABLES
# ==============================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ==============================================

# ==============================================
# FIREBASE ADMIN SDK CONFIGURATION
# ==============================================
# Get these from Firebase Console > Project Settings > Service Accounts
# Download the JSON file and extract values, OR use serviceAccountKey.json file
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ==============================================
# STRIPE PAYMENT CONFIGURATION
# ==============================================
# Get from Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
FRONTEND_URL=http://localhost:5173
PORT=5001
NODE_ENV=development

# ==============================================
# REDIS CONFIGURATION (Optional - for rate limiting)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# Get from SendGrid > Settings > API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# ==============================================
# WEB3 CONFIGURATION
# ==============================================
# Get from Web3Auth Dashboard
VITE_WEB3AUTH_CLIENT_ID=your-web3auth-client-id
VITE_WEB3_RPC_TARGET=https://mainnet.infura.io/v3/your-infura-key

# ==============================================
# THIRDWEB NFT CONFIGURATION (Required for claims)
# ==============================================
# Contract address on Polygon (ERC721)
THIRDWEB_NFT_CONTRACT=0x...
# Thirdweb API secret key (from dashboard)
THIRDWEB_SECRET_KEY=xxx
# Thirdweb Engine URL (optional, uses default if not set)
THIRDWEB_ENGINE_URL=https://engine.thirdweb.com
# Engine access token for backend wallet
THIRDWEB_ENGINE_ACCESS_TOKEN=xxx
# Wallet address that holds pre-minted NFTs
NFT_OWNER_WALLET=0x...
# Private key fallback (if not using Engine)
MINTING_WALLET_PRIVATE_KEY=xxx

# ==============================================
# MORALIS CONFIGURATION
# ==============================================
# Get from Moralis Admin Panel
MORALIS_API_KEY=your-moralis-api-key
# Webhook secret for verifying Moralis Stream webhooks
MORALIS_WEBHOOK_SECRET=your-webhook-secret

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# 32-byte hex key for encrypting PII (email, phone, birthday)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Internal API key for server-to-server calls (content drops, etc)
INTERNAL_API_KEY=your-random-internal-api-key

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_VERIFIED_MULTIPLIER=5

# ==============================================
# REDIS/QUEUE CONFIGURATION (Required for BullMQ)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# For production (Railway/Upstash Redis):
# REDIS_URL=rediss://:<password>@<host>:<port>

# ==============================================
# BLOCKCHAIN CONFIGURATION (Polygon)
# ==============================================
# Alchemy RPC endpoint for Polygon (chainId 137 mainnet, 80002 Amoy testnet)
# ALCHEMY_RPC_URL overrides everything; otherwise the chain-specific URL below
# is used based on POLYGON_CHAIN_ID, falling back to ALCHEMY_API_KEY.
ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY
POLYGON_CHAIN_ID=137

# Backend wallet (holds pre-minted NFTs)
BACKEND_WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed NFT contract address (ERC-721 on Polygon)
NFT_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# ==============================================
# TWILIO (SMS for 2FA)
# ==============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# CLOUDFRONT/S3 CONFIGURATION (For signed URLs)
# ==============================================
CLOUDFRONT_DOMAIN=d123456789.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=YOUR_KEY_PAIR_ID
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"

# S3 fallback
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_REGION=us-east-1
S3_BUCKET_NAME=crownmania-content