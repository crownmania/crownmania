rules_version = '2';

// All Firestore access is server-side only via the Admin SDK, which bypasses
// these rules. The frontend performs NO client-SDK reads or writes — every
// collection (claimCodes, inventory, orders, users, collectibles, analytics)
// is denied to direct client access. If a future feature needs client reads,
// add a targeted rule for that collection only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
