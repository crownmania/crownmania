# =========================================
# SMART CONTRACT ENVIRONMENT VARIABLES
# =========================================
# Copy to .env and fill in your values

# Alchemy RPC URL for Polygon Amoy testnet
# Get one at: https://dashboard.alchemy.com
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/your-alchemy-api-key

# Alchemy RPC URL for Polygon mainnet (production)
ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/your-alchemy-api-key

# Deployer wallet private key (WITHOUT 0x prefix)
# ⚠️  NEVER commit this to git! Add .env to .gitignore
# Generate a new wallet at: https://vanity-eth.tk or via ethers.Wallet.createRandom()
DEPLOYER_PRIVATE_KEY=your-64-hex-char-private-key

# Polygonscan API key (for contract verification)
# Get one at: https://polygonscan.com/register
POLYGONSCAN_API_KEY=your-polygonscan-api-key
